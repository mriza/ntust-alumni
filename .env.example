# Salin file ini menjadi .env dan isi seluruh nilai rahasia sebelum menjalankan aplikasi:
#   cp .env.example .env

# CouchDB (wajib)
COUCHDB_USER=admin
COUCHDB_PASSWORD=GANTI_PASSWORD_COUCHDB_YANG_KUAT
COUCHDB_URL=http://admin:GANTI_PASSWORD_COUCHDB_YANG_KUAT@localhost:5984

# Backend (wajib)
JWT_SECRET=GANTI_DENGAN_JWT_SECRET_ACAK_MINIMAL_32_KARAKTER
PORT=8080
FRONTEND_URL=http://localhost:8081
VERIFICATION_ALLOWED_DOMAINS=@mail.ntust.edu.tw

# Brevo Email, SMS, & WhatsApp (isi untuk pengiriman OTP live)
BREVO_API_KEY=
BREVO_FROM_EMAIL=ntust-alumni-verification@cerdas.club
BREVO_FROM_NAME=Alumni NTUST Indonesia
BREVO_SMS_SENDER=NTUSTAlumni
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=

# Seed CLI passwords (wajib hanya saat menjalankan cmd/seed)
SEED_ADMIN_PASSWORD=GANTI_PASSWORD_SEED_ADMIN
SEED_REGIONAL_ADMIN_PASSWORD=GANTI_PASSWORD_SEED_ADMIN_WILAYAH
SEED_PENGURUS_PASSWORD=GANTI_PASSWORD_SEED_PENGURUS
SEED_MEMBER_PASSWORD=GANTI_PASSWORD_SEED_MEMBER
